
---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';

// -----------------------------------------------------------------------
// Add / edit your events here. Each event needs: title, date, time,
// location, description, and optionally a link (ticket page, RSVP, etc).
// -----------------------------------------------------------------------
const events = [
  {
    title: 'Book Signing — Downtown Books & Coffee',
    date: '2026-08-14',
    time: '6:00 PM',
    location: 'Downtown Books & Coffee, Baton Rouge, LA',
    description:
      'Join me for a reading from my latest novel, followed by a Q&A and signed copies.',
    link: '',
  },
  {
    title: 'Author Panel — Southern Writers Festival',
    date: '2026-09-22',
    time: '2:00 PM',
    location: 'Southern Writers Festival, New Orleans, LA',
    description:
      'A panel discussion on Southern fiction with three other regional authors.',
    link: '',
  },
  {
    title: 'Library Reading — Main Branch',
    date: '2026-03-02',
    time: '5:30 PM',
    location: 'Baton Rouge Main Library',
    description: 'An evening reading and discussion of short fiction.',
    link: '',
  },
];

const formatDate = (dateStr: string) =>
  new Date(dateStr).toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const now = new Date();

const upcoming = events
  .filter((e) => new Date(e.date).getTime() >= now.getTime())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const past = events
  .filter((e) => new Date(e.date).getTime() < now.getTime())
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const metadata = {
  title: 'Events',
  description: 'Upcoming readings, signings, and appearances.',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto max-w-4xl">
    <Headline
      title="Events"
      subtitle="Readings, signings, and appearances — come say hello."
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold mb-6 dark:text-white">Upcoming</h2>

      {
        upcoming.length === 0 ? (
          <p class="text-gray-500 dark:text-slate-400">
            No upcoming events scheduled right now — check back soon.
          </p>
        ) : (
          <div class="space-y-6">
            {upcoming.map((event) => (
              <div class="border border-gray-200 dark:border-slate-700 rounded-lg p-6 hover:shadow-md transition-shadow">
                <p class="text-sm font-semibold text-primary dark:text-blue-400">
                  {formatDate(event.date)} · {event.time}
                </p>
                <h3 class="text-xl font-bold mt-1 dark:text-white">
                  {event.title}
                </h3>
                <p class="text-gray-600 dark:text-slate-400 mt-1">
                  {event.location}
                </p>
                <p class="mt-3 text-gray-700 dark:text-slate-300">
                  {event.description}
                </p>
                {event.link && (
                  <a
                    href={event.link}
                    class="inline-block mt-4 text-primary font-medium hover:underline"
                  >
                    More info →
                  </a>
                )}
              </div>
            ))}
          </div>
        )
      }
    </div>

    {
      past.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-bold mb-6 dark:text-white">Past Events</h2>
          <div class="space-y-4">
            {past.map((event) => (
              <div class="border-b border-gray-200 dark:border-slate-700 pb-4">
                <p class="text-sm text-gray-500 dark:text-slate-400">
                  {formatDate(event.date)}
                </p>
                <h3 class="text-lg font-semibold dark:text-white">
                  {event.title}
                </h3>
                <p class="text-gray-500 dark:text-slate-400">
                  {event.location}
                </p>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>
