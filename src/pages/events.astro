---
import Layout from '../layouts/Layout.astro';
import { books } from '../data/books';
import { events } from '../data/events';

const formatDate = (dateStr: string) =>
  new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const now = new Date();

const upcoming = events
  .filter((e) => new Date(e.date).getTime() >= now.getTime())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const past = events
  .filter((e) => new Date(e.date).getTime() < now.getTime())
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const buyLinksFor = (bookSlug?: string) => books.find((b) => b.slug === bookSlug)?.buyLinks ?? [];
---

<Layout
  metadata={{
    title: 'Events | Patrick O’Dell',
    description: 'Upcoming readings, signings, launches, and appearances from author Patrick O’Dell.',
  }}
>
  <section class="events-hero">
    <div class="container center">
      <span class="kicker">Events</span>
      <h1>Readings, Signings & Appearances</h1>
      <p class="hero-intro">Come say hello. Here’s where you can find me next.</p>
    </div>
  </section>

  <section class="events-section">
    <div class="container narrow">
      <div class="section-heading">
        <span class="kicker">Upcoming</span>
        <h2>What’s Next</h2>
      </div>

      {
        upcoming.length === 0 ? (
          <p class="empty">No upcoming events scheduled right now — check back soon.</p>
        ) : (
          <div class="event-list">
            {upcoming.map((event) => (
              <article class="event-card featured" id={event.slug}>
                <p class="event-date">{event.dateLabel || formatDate(event.date)}</p>

                <h3>{event.title}</h3>

                {(event.time || event.location) && (
                  <p class="event-meta">
                    {event.time}
                    {event.time && event.location ? ' · ' : ''}
                    {event.location}
                  </p>
                )}

                <p class="event-description">{event.description}</p>

                {buyLinksFor(event.bookSlug).length > 0 && (
                  <div class="buy-links">
                    <span class="buy-label">Preorder / Buy</span>
                    <div class="buy-buttons">
                      {buyLinksFor(event.bookSlug).map((buy) => (
                        <a class="btn secondary" href={buy.url}>
                          {buy.retailer}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {event.link && (
                  <a href={event.link} class="more-info">
                    More info →
                  </a>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="events-section alt">
        <div class="container narrow">
          <div class="section-heading">
            <span class="kicker">Archive</span>
            <h2>Past Events</h2>
          </div>

          <div class="event-list">
            {past.map((event) => (
              <article class="event-card past" id={event.slug}>
                <p class="event-date">{formatDate(event.date)}</p>
                <h3>{event.title}</h3>
                {event.location && <p class="event-meta">{event.location}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="events-section newsletter-section">
    <div class="container narrow center">
      <span class="kicker">Stay in the Loop</span>
      <h2>Never Miss an Event</h2>
      <p class="newsletter-text">
        Join the newsletter and be the first to know when new signings, panels, and launch events are announced.
      </p>
      <a href="/contact" class="btn primary">Get in Touch</a>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .narrow {
    max-width: 760px;
  }

  .center {
    text-align: center;
  }

  .kicker {
    display: block;
    margin-bottom: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(188, 170, 146, 0.58);
  }

  h1 {
    font-size: 2.5rem;
    line-height: 1.08;
    margin-bottom: 16px;
  }

  h2 {
    font-size: 1.8rem;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }

  p {
    font-size: 0.98rem;
    line-height: 1.9;
    color: rgba(230, 220, 205, 0.8);
  }

  .events-hero {
    padding: 70px 20px 40px;
  }

  .hero-intro {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  .events-section {
    padding: 60px 20px;
    scroll-margin-top: 20px;
  }

  .events-section.alt {
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.015), rgba(255, 255, 255, 0.01));
  }

  .section-heading {
    margin-bottom: 30px;
    text-align: center;
  }

  .empty {
    text-align: center;
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .event-card {
    padding: 28px;
    border: 1px solid rgba(210, 198, 178, 0.12);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.015);
    scroll-margin-top: 100px;
  }

  .event-card.featured {
    border-color: rgba(214, 199, 161, 0.35);
    background: rgba(214, 199, 161, 0.04);
  }

  .event-card.past {
    padding: 18px 28px;
    opacity: 0.75;
  }

  .event-date {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(214, 199, 161, 0.85);
    margin-bottom: 8px;
  }

  .event-meta {
    color: rgba(230, 220, 205, 0.6);
    margin-bottom: 4px;
  }

  .event-description {
    margin-top: 10px;
  }

  .buy-links {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(210, 198, 178, 0.12);
  }

  .buy-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(188, 170, 146, 0.58);
    margin-bottom: 12px;
  }

  .buy-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .more-info {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.9rem;
    color: rgba(214, 199, 161, 0.9);
  }

  .newsletter-section {
    padding-bottom: 100px;
  }

  .newsletter-text {
    max-width: 520px;
    margin: 0 auto 24px;
  }

  .btn {
    display: inline-block;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: 6px;
  }

  .btn.primary {
    background: rgba(214, 199, 161, 0.9);
    color: #14120f;
  }

  .btn.secondary {
    border: 1px solid rgba(210, 198, 178, 0.3);
    color: rgba(230, 220, 205, 0.9);
  }

  .btn.primary:hover {
    background: rgba(214, 199, 161, 1);
  }

  .btn.secondary:hover {
    border-color: rgba(214, 199, 161, 0.6);
    color: rgba(250, 242, 230, 0.95);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .event-card {
      padding: 22px;
    }
  }
</style>
