---
import Layout from "../layouts/Layout.astro";
import { books } from "../data/books";

const featured = books[0];
---

<Layout
  metadata={{
    title: "Patrick O’Dell",
    description: "Official website of author Patrick O’Dell"
  }}
>

<section class="hero">

  <div class="hero-container">

    <div class="hero-image">

      <img
        src={featured.cover.src}
        width={featured.cover.width}
        height={featured.cover.height}
        alt={featured.title}
      />

    </div>

    <div class="hero-content">

      <p class="eyebrow">
        THE GODFIRE SERIES
      </p>

      <h1>{featured.title}</h1>

      {featured.blurb.map((line) => (
        <p>{line}</p>
      ))}

      <div class="hero-actions">
        <a href={`/books/${featured.slug}`} class="primary-btn">
          Explore Book
        </a>

        <a href="/books" class="secondary-btn">
          View All Books
        </a>
      </div>

    </div>

  </div>

</section>

</Layout>

<style>
.hero {
  padding: 90px 24px 120px;
}

.hero-container {
  max-width: 1200px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 480px 1fr;
  gap: 70px;

  align-items: center;
}

.hero-image img {
  width: 100%;
  max-width: 480px;

  border-radius: 12px;

  box-shadow:
    0 30px 80px rgba(0,0,0,0.55);
}

.hero-content {
  max-width: 650px;
}

.hero-content h1 {
  margin: 16px 0 24px;
}

.hero-content p {
  font-size: 1.05rem;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.85rem;
  opacity: 0.7;
}

.hero-actions {
  display: flex;
  gap: 18px;
  margin-top: 36px;
}

.primary-btn,
.secondary-btn {
  padding: 14px 22px;
  border-radius: 8px;
  text-decoration: none;
  transition: 0.2s ease;
}

.primary-btn {
  background: rgba(214,196,168,0.95);
  color: #15130f;
}

.secondary-btn {
  border: 1px solid rgba(255,255,255,0.15);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-2px);
}

@media (max-width: 980px) {

  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-image img {
    max-width: 360px;
    margin: 0 auto;
  }

  .hero-content {
    margin: 0 auto;
  }

  .hero-actions {
    justify-content: center;
  }
}
</style>
