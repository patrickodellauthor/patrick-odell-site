---
import Layout from "../layouts/Layout.astro";
import { books } from "../data/books";

// Featured book is now system-driven (prepares for automation step C)
const featured = books.find((b) => b.slug === "gods-and-monsters") ?? books[0];
---

<Layout
  metadata={{
    title: "Patrick O’Dell | Author",
    description:
      "Official website of Patrick O’Dell, author of The Godfire Series — fantasy and urban fantasy fiction focused on hidden systems, transformation, and the structures beneath reality.",
  }}
>

  <!-- FEATURED BOOK / HERO -->
  <section class="section hero">
    <div class="container center hero-layout">

      <a href={`/books/${featured.slug}`} class="hero-media">
        <img
          src={featured.cover}
          alt={`${featured.title} Cover`}
          class="hero-image"
        />
      </a>

      <div class="hero-text">

        <span class="kicker">Featured Release</span>

        <h1>{featured.title}</h1>

        <p>
          {featured.excerpt}
        </p>

        <div class="buttons">
          <a class="btn primary" href={`/books/${featured.slug}`}>
            View Book
          </a>

          <a class="btn secondary" href="/books">
            Explore Series
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- NEWS & UPDATES -->
  <section class="section news-section">
    <div class="container center">

      <div class="section-heading">
        <span class="kicker">News & Updates</span>
        <h2>Latest Updates</h2>
      </div>

      <div class="news-box">

        <article class="news-item">
          <span class="date">May 2026</span>
          <p>
            The Godfire Series continues development across multiple entries,
            including ongoing revisions and expanded worldbuilding systems.
          </p>
        </article>

        <article class="news-item">
          <span class="date">May 2026</span>
          <p>
            The official Patrick O’Dell website is being rebuilt around a
            warmer, editorial-style reading experience.
          </p>
        </article>

        <article class="news-item">
          <span class="date">April 2026</span>
          <p>
            New Elderspeech systems, lore archives, and timeline structures
            are currently being prepared for site integration.
          </p>
        </article>

        <article class="news-item">
          <span class="date">March 2026</span>
          <p>
            Internal canon documentation and structural worldbuilding archives
            continue expanding behind the scenes.
          </p>
        </article>

        <article class="news-item">
          <span class="date">February 2026</span>
          <p>
            Additional Godfire Series material and supporting narrative systems
            entered active development.
          </p>
        </article>

      </div>

    </div>
  </section>

  <!-- AUTHOR -->
  <section class="section author-section">
    <div class="container center author-layout">

      <a href="/about" class="author-media">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell Author Portrait"
          class="author-image"
        />
      </a>

      <div class="author-text">

        <span class="kicker">Author</span>

        <h2>Patrick O’Dell</h2>

        <p>
          Patrick O’Dell writes fantasy and urban fantasy fiction centered on
          hidden systems beneath reality, fractured identity, transformation,
          and the cost of power.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

</Layout>

<style>

/* =========================
   GLOBAL LAYOUT (REFINED FLOW)
========================= */

.section {
  padding: 70px 20px;
}

.section + .section {
  border-top: 1px solid rgba(210,198,178,0.05);
}

.container.center {
  max-width: 980px;
  margin: 0 auto;
}

.section-heading {
  text-align: center;
  margin-bottom: 24px;
}

/* =========================
   HERO (BOOK-FIRST FOCUS)
========================= */

.hero {
  padding-top: 60px;
  padding-bottom: 60px;
}

.hero-layout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56px;
}

.hero-media {
  flex-shrink: 0;
}

.hero-image {
  width: 270px;
  border-radius: 8px;

  display: block;

  box-shadow: 0 24px 60px rgba(0,0,0,0.42);

  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.hero-image:hover {
  transform: translateY(-4px);
  box-shadow: 0 30px 75px rgba(0,0,0,0.5);
}

.hero-text {
  max-width: 480px;
}

/* =========================
   AUTHOR SECTION
========================= */

.author-section {
  padding-top: 50px;
  padding-bottom: 90px;
}

.author-layout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 46px;
}

.author-text {
  max-width: 520px;
}

.author-image {
  width: 185px;
  border-radius: 10px;

  display: block;

  box-shadow: 0 22px 55px rgba(0,0,0,0.34);

  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.author-image:hover {
  transform: translateY(-4px);
  box-shadow: 0 28px 70px rgba(0,0,0,0.45);
}

/* =========================
   TYPOGRAPHY (UNIFIED SYSTEM ALIGNMENT)
========================= */

.kicker {
  display: block;
  margin-bottom: 10px;

  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  color: rgba(188,170,146,0.58);
}

h1 {
  font-size: 2rem;
  line-height: 1.1;
  margin-bottom: 14px;
}

h2 {
  font-size: 1.65rem;
  line-height: 1.2;
  margin-bottom: 12px;
}

p {
  font-size: 0.98rem;
  line-height: 1.82;
  color: rgba(230,220,205,0.78);
}

/* =========================
   BUTTONS
========================= */

.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 22px;
}

/* =========================
   NEWS FEED (CENTERED BUT CONTROLLED WIDTH)
========================= */

.news-section {
  padding-top: 40px;
}

.news-box {
  max-width: 780px;
  margin: 26px auto 0;

  max-height: 420px;
  overflow-y: auto;

  padding-right: 6px;

  text-align: left;
}

.news-item {
  padding: 20px 0;
  border-bottom: 1px solid rgba(210,198,178,0.10);
}

.news-item:last-child {
  border-bottom: none;
}

.date {
  display: block;
  margin-bottom: 6px;

  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  color: rgba(188,170,146,0.58);
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 860px) {

  .hero-layout,
  .author-layout {
    flex-direction: column;
    text-align: center;
  }

  .hero-text,
  .author-text {
    max-width: 100%;
  }

  .hero-image {
    width: 240px;
  }

  .author-image {
    width: 170px;
  }

  .buttons {
    justify-content: center;
  }

  h1 {
    font-size: 1.85rem;
  }

  h2 {
    font-size: 1.45rem;
  }

  .section {
    padding: 62px 20px;
  }
}

</style>
