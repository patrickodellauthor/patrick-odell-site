---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Patrick O’Dell | Author">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="title">Patrick O’Dell</h1>
      <p class="subtitle">Fantasy & Urban Fantasy Author</p>

      <p class="tagline">
        Stories of broken systems, hidden structures beneath reality, and the cost of power.
      </p>

      <div class="buttons">
        <a class="btn primary" href="/#books">Books</a>
        <a class="btn secondary" href="/about">About</a>
      </div>
    </div>
  </section>

  <!-- FEATURED BOOK -->
  <section id="books" class="section">
    <div class="container">
      <h2>Featured Book</h2>

      <div class="book">
        <img src="/gods-and-monsters-cover.jpg" alt="Gods and Monsters Cover" />

        <div class="book-info">
          <h3>Gods and Monsters</h3>

          <p>
            Haunted by the past and hunted by forces beyond understanding, Elias Fetch must decide what he is willing to become to save the people he loves.
          </p>

          <a class="btn primary" href="/books">Explore Books</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section alt">
    <div class="container">
      <h2>About</h2>

      <p>
        Patrick O’Dell writes immersive fantasy and urban fantasy stories that
        explore hidden systems beneath reality, the structure of power, and the
        consequences of breaking it.
      </p>

      <a class="btn secondary" href="/about">Read More</a>
    </div>
  </section>

  <!-- WORLDS TEASER -->
  <section class="section">
    <div class="container">
      <h2>Worlds & Lore</h2>

      <p>
        Step behind the stories into the worlds beneath.
      </p>

      <a class="btn secondary" href="/worlds">Explore Lore</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 120px 20px;
    text-align: center;
  }

  .title {
    font-size: 3rem;
    margin-bottom: 10px;
  }

  .subtitle {
    font-size: 1.25rem;
    opacity: 0.8;
    margin-bottom: 20px;
  }

  .tagline {
    max-width: 600px;
    margin: 0 auto 30px;
    opacity: 0.75;
  }

  .buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .section {
    padding: 80px 20px;
  }

  .section.alt {
    background: rgba(0, 0, 0, 0.03);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .book {
    display: flex;
    gap: 30px;
    align-items: center;
    margin-top: 20px;
  }

  .book img {
    width: 180px;
    border-radius: 8px;
  }

  .book-info {
    flex: 1;
  }

  .btn {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 10px;
  }

  .primary {
    background: black;
    color: white;
  }

  .secondary {
    border: 1px solid black;
    color: black;
  }
</style>
