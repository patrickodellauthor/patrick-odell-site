---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "Patrick O’Dell | Author" }}>

  <!-- HERO (NOW FEATURED BOOK FOCUS) -->
  <section class="hero">
    <div class="container hero-container">

      <div class="featured-book-hero">

        <img
          src="/gods-and-monsters-cover.jpg"
          alt="Gods and Monsters Cover"
          class="hero-book-cover"
        />

        <div class="hero-book-content">

          <span class="series-tag">The Godfire Series</span>

          <h1>Gods and Monsters</h1>

          <p class="tagline">
            Haunted by the past and hunted by forces beyond understanding,
            Elias Fetch must decide what he is willing to become to save
            the people he loves.
          </p>

          <div class="buttons">
            <a class="btn primary" href="/books/gods-and-monsters">
              View Book
            </a>

            <a class="btn secondary" href="/books">
              Explore Series
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- NEWS / UPDATES -->
  <section class="section">
    <div class="container narrow">

      <div class="section-heading">
        <span class="section-kicker">News & Updates</span>
        <h2>Latest Dispatches</h2>
      </div>

      <div class="dispatch-feed">

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Writing Update</span>
            <span>May 2026</span>
          </div>

          <h3>The Godfire Series Continues</h3>
          <p>
            Work continues across multiple entries in The Godfire Series,
            including revisions and expansion of world systems.
          </p>
        </article>

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Website</span>
            <span>May 2026</span>
          </div>

          <h3>Site Rebuilding in Progress</h3>
          <p>
            The site is being redesigned for a warmer, more immersive reading experience.
          </p>
        </article>

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Lore</span>
            <span>May 2026</span>
          </div>

          <h3>World Archive Expansion</h3>
          <p>
            Elderspeech systems and lore archives are being prepared for integration.
          </p>
        </article>

      </div>

    </div>
  </section>

  <!-- AUTHOR -->
  <section class="section author-intro">
    <div class="container narrow author-grid">

      <a href="/about" class="author-photo-link">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell Author Photo"
          class="author-photo"
        />
      </a>

      <div class="author-text">

        <div class="section-heading">
          <span class="section-kicker">Author</span>
          <h2>Patrick O’Dell</h2>
        </div>

        <p class="about-text">
          Patrick O’Dell writes fantasy and urban fantasy fiction centered on
          hidden systems beneath reality, fractured identity, and transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

</Layout>
