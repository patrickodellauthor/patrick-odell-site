---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "Patrick O’Dell | Author" }}>

  <!-- FEATURED BOOK (CENTERED HERO) -->
  <section class="section hero">
    <div class="container center">

      <a href="/books/gods-and-monsters" class="hero-media">
        <img
          src="/gods-and-monsters-cover.jpg"
          alt="Gods and Monsters Cover"
          class="hero-image"
        />
      </a>

      <div class="hero-text">

        <span class="kicker">Featured Release</span>

        <h1>Gods and Monsters</h1>

        <p>
          Haunted by the past and hunted by forces beyond understanding,
          Elias Fetch must decide what he is willing to become to save
          the people he loves.
        </p>

        <div class="buttons">
          <a class="btn primary" href="/books/gods-and-monsters">
            View Book
          </a>
          <a class="btn secondary" href="/books">
            Explore Series
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- NEWS (CENTERED + LARGER + ELEVATED) -->
  <section class="section">
    <div class="container center">

      <span class="kicker">News & Updates</span>
      <h2>Latest Dispatches</h2>

      <div class="news-box">

        <div class="news-item">
          <span class="date">May 2026</span>
          <p>The Godfire Series continues development across multiple entries.</p>
        </div>

        <div class="news-item">
          <span class="date">May 2026</span>
          <p>The website is being rebuilt for a warmer, more immersive reading experience.</p>
        </div>

        <div class="news-item">
          <span class="date">April 2026</span>
          <p>New Elderspeech systems and lore archives are being integrated.</p>
        </div>

        <div class="news-item">
          <span class="date">March 2026</span>
          <p>Expanded worldbuilding documentation added to internal canon.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- AUTHOR (CENTERED BIO BLOCK) -->
  <section class="section">
    <div class="container center">

      <a href="/about">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell"
          class="author-image"
        />
      </a>

      <div class="hero-text">

        <span class="kicker">Author</span>

        <h2>Patrick O’Dell</h2>

        <p>
          Patrick O’Dell writes fantasy and urban fantasy fiction centered on
          hidden systems beneath reality, fractured identity, and transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

</Layout>

<style>

/* CORE CENTERED SYSTEM */
.container.center {
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
}

/* HERO IMAGE */
.hero-image {
  width: 100%;
  max-width: 320px;
  margin: 0 auto 28px;
  display: block;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.45);
  transition: transform 0.25s ease;
}

.hero-image:hover {
  transform: translateY(-4px);
}

/* AUTHOR IMAGE */
.author-image {
  width: 180px;
  height: auto;
  border-radius: 10px;
  margin: 0 auto 24px;
  display: block;
  box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

/* TYPOGRAPHY */
.kicker {
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(188,170,146,0.55);
  display: block;
  margin-bottom: 10px;
}

h1 {
  font-size: 2.2rem;
  margin-bottom: 12px;
}

h2 {
  font-size: 1.6rem;
  margin-bottom: 12px;
}

p {
  font-size: 0.95rem;
  line-height: 1.75;
  color: rgba(230,220,205,0.8);
  max-width: 640px;
  margin: 0 auto;
}

/* NEWS BOX (CENTERED + LARGER) */
.news-box {
  margin-top: 22px;
  max-height: 320px;
  overflow-y: auto;

  padding: 18px;
  border-radius: 8px;

  border: 1px solid rgba(214,196,168,0.18);
  background: rgba(255,255,255,0.02);

  text-align: left;
}

.news-item {
  padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.news-item:last-child {
  border-bottom: none;
}

.news-item .date {
  font-size: 0.72rem;
  color: rgba(188,170,146,0.6);
  display: block;
  margin-bottom: 4px;
}

/* BUTTONS */
.buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 18px;
  flex-wrap: wrap;
}

/* SECTION SPACING FIX */
.section {
  padding: 80px 20px;
}

/* RESPONSIVE */
@media (max-width: 860px) {
  h1 { font-size: 1.9rem; }
  h2 { font-size: 1.4rem; }
}

</style>
