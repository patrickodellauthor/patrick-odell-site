---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Patrick O’Dell | Author">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="title">Patrick O’Dell</h1>
      <p class="subtitle">Fantasy & Urban Fantasy Author</p>

      <p class="tagline">
        Stories of broken systems, hidden structures beneath reality, and the cost of power.
      </p>

      <div class="buttons">
        <a class="btn primary" href="/books">Enter The Godfire Series</a>
        <a class="btn secondary" href="/about">About</a>
      </div>
    </div>
  </section>

<!-- DISPATCH -->
<section class="dispatch">
  <div class="container">
    <p class="dispatch-label">Latest Dispatch</p>

    <p class="dispatch-text">
      Work continues on the Godfire series. New material is being written in silence.
    </p>

    <p class="dispatch-meta">
      Updated recently — Patrick O’Dell
    </p>
  </div>
</section>

  <!-- FEATURED BOOK -->
  <section id="books" class="section">
    <div class="container narrow">
      <h2>Featured Book</h2>

      <hr class="section-divider" />

      <div class="book">
        <img src="/gods-and-monsters-cover.jpg" alt="Gods and Monsters Cover" />

        <div class="book-info">
          <h3>Gods and Monsters</h3>

          <span class="series-tag">The Godfire Series</span>

          <p>
            Haunted by the past and hunted by forces beyond understanding, Elias Fetch must decide what he is willing to become to save the people he loves.
          </p>

          <a class="btn primary" href="/books">Explore Books</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section alt">
    <div class="container narrow">
      <h2>About</h2>

      <hr class="section-divider" />

      <p class="about-text">
        Patrick O’Dell writes fantasy and urban fantasy fiction centered on fractured identities, harsh worlds, and the things people become when certainty begins to fail.
      </p>

      <a class="btn secondary" href="/about">Read More</a>
    </div>
  </section>

  <!-- WORLDS TEASER -->
  <section class="section">
    <div class="container narrow">
      <h2>Worlds & Lore</h2>

      <hr class="section-divider" />

      <p class="lore-text">
        Step behind the stories into the worlds beneath.
      </p>

      <a class="btn secondary" href="/worlds">Explore Lore</a>
    </div>
  </section>
</Layout>

<!-- NEWS FEED -->
<section class="section alt">
  <div class="container">

    <h2>Dispatches</h2>

    <div class="news-feed">

      <article class="news-item">
        <span class="tag">Update</span>
        <h3>Writing Progress</h3>
        <p>
          Work continues on The Godfire Series as Elias Fetch’s story deepens into darker territory.
        </p>
      </article>

      <article class="news-item">
        <span class="tag">Lore</span>
        <h3>World Expansion Note</h3>
        <p>
          New structural elements of the Lore system are being refined behind the scenes.
        </p>
      </article>

      <article class="news-item">
        <span class="tag">Book</span>
        <h3>Watchers in the Dark</h3>
        <p>
          New material is being prepared for upcoming previews and excerpt releases.
        </p>
      </article>

    </div>

  </div>
</section>


<style>
.hero {
  padding: 90px 20px 70px;
  text-align: center;
}

.title {
  font-size: 2.4rem;
  font-weight: 400;
  letter-spacing: 0.3px;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 1.1rem;
  opacity: 0.8;
  margin-bottom: 20px;
}

.tagline {
  max-width: 520px;
  margin: 0 auto 26px;
  color: rgba(255,255,255,0.55);
  font-size: 0.95rem;
  line-height: 1.6;
}

.buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.section {
  padding: 70px 20px;
}

.section.alt {
  background: rgba(255,255,255,0.015);
}

.container {
  max-width: 900px;
  margin: 0 auto;
}

.book {
  display: flex;
  gap: 26px;
  align-items: flex-start;
  margin-top: 18px;
}

.book img {
  width: 170px;
  border-radius: 6px;
  opacity: 0.95;
}

.book-info {
  flex: 1;
}

.btn {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 6px;
  text-decoration: none;
  margin-top: 10px;
  font-size: 0.9rem;
}

.primary {
  background: rgba(255,255,255,0.92);
  color: #0a0a0a;
}

.secondary {
  border: 1px solid rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.85);
}

.dispatch {
  padding: 40px 20px 10px;
  text-align: center;
}

.dispatch .container {
  max-width: 700px;
  margin: 0 auto;
}

.dispatch-label {
  font-size: 0.75rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  margin-bottom: 10px;
}

.dispatch-text {
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.72);
  margin-bottom: 10px;
}

.dispatch-meta {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.35);
}

.news-feed {
  display: grid;
  gap: 18px;
  margin-top: 20px;
}

.news-item {
  padding: 16px 18px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(0,0,0,0.2);
  border-radius: 8px;
}

.news-item h3 {
  margin: 6px 0;
  font-size: 1.05rem;
}

.news-item p {
  opacity: 0.75;
  font-size: 0.95rem;
}

.tag {
  font-size: 0.7rem;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  opacity: 0.5;
}

</style>
