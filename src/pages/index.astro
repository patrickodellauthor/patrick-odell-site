---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "Patrick O’Dell | Author" }}>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-container">

      <img
        src="/patrick-odell-logo.png"
        alt="Patrick O'Dell Author Logo"
        class="hero-logo"
      />

      <p class="tagline">
        Stories of broken systems, hidden structures beneath reality,
        and the cost of power.
      </p>

      <div class="buttons">
        <a class="btn primary" href="/books">
          Explore The Godfire Series
        </a>

        <a class="btn secondary" href="/about">
          About the Author
        </a>
      </div>

    </div>
  </section>

  <!-- AUTHOR INTRO -->
  <section class="section author-intro">
    <div class="container narrow author-grid">

      <a href="/about" class="author-photo-link">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell Author Photo"
          class="author-photo"
        />
      </a>

      <div class="author-text">

        <div class="section-heading">
          <span class="section-kicker">Author</span>
          <h2>Patrick O’Dell</h2>
        </div>

        <p class="about-text">
          Patrick O’Dell writes fantasy and urban fantasy fiction focused on
          fractured identity, hidden systems beneath reality, and the cost of
          transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

  <!-- NEWS -->
  <section class="section">
    <div class="container narrow">

      <div class="section-heading">
        <span class="section-kicker">News & Updates</span>
        <h2>Latest Updates</h2>
      </div>

      <div class="dispatch-feed">

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Writing Update</span>
            <span>May 2026</span>
          </div>

          <h3>The Godfire Series Continues</h3>
          <p>
            Work continues across multiple entries in The Godfire Series,
            including revisions and world expansion.
          </p>
        </article>

      </div>

    </div>
  </section>

</Layout>
