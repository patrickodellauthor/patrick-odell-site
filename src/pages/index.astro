---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "Patrick O’Dell | Author" }}>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-container">

      <img
        src="/patrick-odell-logo.png"
        alt="Patrick O'Dell Author Logo"
        class="hero-logo"
      />

      <p class="tagline">
        Stories of broken systems, hidden structures beneath reality,
        and the cost of power.
      </p>

      <div class="buttons">
        <a class="btn primary" href="/books">
          Explore The Godfire Series
        </a>

        <a class="btn secondary" href="/about">
          About the Author
        </a>
      </div>

    </div>
  </section>

  <!-- AUTHOR INTRO -->
  <section class="section author-intro">
    <div class="container narrow author-grid">

      <a href="/about" class="author-photo-link">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell Author Photo"
          class="author-photo"
        />
      </a>

      <div class="author-text">

        <div class="section-heading">
          <span class="section-kicker">Author</span>
          <h2>Patrick O’Dell</h2>
        </div>

        <p class="about-text">
          Patrick O’Dell writes fantasy and urban fantasy fiction focused on
          fractured identity, hidden systems beneath reality, and the cost of
          transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

  <!-- NEWS -->
  <section class="section compact">
    <div class="container narrow">

      <div class="section-heading">
        <span class="section-kicker">News & Updates</span>
        <h2>Latest Updates</h2>
      </div>

      <div class="dispatch-feed">

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Writing Update</span>
            <span>May 2026</span>
          </div>

          <h3>The Godfire Series Continues</h3>
          <p>
            Work continues across multiple entries in The Godfire Series.
          </p>
        </article>

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Website</span>
            <span>May 2026</span>
          </div>

          <h3>Site Rebuilding in Progress</h3>
          <p>
            The website is being redesigned for a warmer reading experience.
          </p>
        </article>

        <article class="dispatch-card">
          <div class="dispatch-meta">
            <span>Lore</span>
            <span>May 2026</span>
          </div>

          <h3>World Archive Expansion</h3>
          <p>
            Elderspeech systems and worldbuilding archives are expanding.
          </p>
        </article>

      </div>

    </div>
  </section>

  <!-- FEATURED BOOK -->
  <section class="section compact">
    <div class="container narrow">

      <div class="section-heading">
        <span class="section-kicker">Featured Release</span>
        <h2>Gods and Monsters</h2>
      </div>

      <div class="featured-book">

        <img
          src="/gods-and-monsters-cover.jpg"
          alt="Gods and Monsters Cover"
        />

        <div class="featured-content">

          <span class="series-tag">The Godfire Series</span>

          <p>
            Elias Fetch must decide what he is willing to become to save those he loves.
          </p>

          <div class="buttons left">
            <a class="btn primary" href="/books/gods-and-monsters">
              View Book
            </a>

            <a class="btn secondary" href="#">
              Preorder
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- LORE -->
  <section class="section tight alt">
    <div class="container narrow">

      <div class="section-heading">
        <span class="section-kicker">Lore Archive</span>
        <h2>Worlds Beneath the Story</h2>
      </div>

      <p class="about-text">
        Explore timelines, entities, systems, and Elderspeech archives.
      </p>

      <a class="btn secondary" href="/lore">
        Explore Lore
      </a>

    </div>
  </section>

</Layout>

<style>

/* =========================
   EDITORIAL SPACING SYSTEM
========================= */

.hero {
  padding: 140px 20px 90px;
}

.author-intro {
  padding: 70px 20px 40px;
}

.section {
  padding: 70px 20px;
}

/* tighter “reading flow” sections */
.section.compact {
  padding: 55px 20px;
}

.section.tight {
  padding: 45px 20px;
}

/* subtle visual separation instead of big gaps */
.section.alt {
  background: rgba(255,255,255,0.015);
}

/* containers */
.container {
  max-width: 1100px;
  margin: 0 auto;
}

.narrow {
  max-width: 860px;
}

/* =========================
   TYPOGRAPHY RHYTHM FIX
========================= */

.section-heading {
  margin-bottom: 18px;
}

.section-heading h2 {
  margin-top: 6px;
  margin-bottom: 0;
}

.section-kicker {
  letter-spacing: 0.16em;
  opacity: 0.6;
}

/* =========================
   AUTHOR GRID (SOFTER)
========================= */

.author-grid {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 36px;
  align-items: center;
}

.author-photo {
  width: 100%;
  border-radius: 10px;
  box-shadow: 0 18px 50px rgba(0,0,0,0.35);
  transition: transform 0.25s ease;
}

.author-photo:hover {
  transform: translateY(-3px);
}

/* =========================
   CARDS (LESS BOXY)
========================= */

.dispatch-feed {
  display: grid;
  gap: 16px;
}

.dispatch-card {
  padding: 20px;
  border-radius: 8px;
  border: 1px solid rgba(214,196,168,0.06);
  background: rgba(255,255,255,0.015);
}

/* =========================
   FEATURED BOOK TIGHTENING
========================= */

.featured-book {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 34px;
  align-items: start;
}

.featured-book img {
  border-radius: 8px;
}

/* =========================
   BUTTON SPACING POLISH
========================= */

.buttons {
  margin-top: 18px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 860px) {

  .author-grid,
  .featured-book {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .buttons.left {
    justify-content: center;
  }
}
</style>
