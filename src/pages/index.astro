---
import Layout from '../layouts/Layout.astro';
import { books } from '../data/books';

const featured = books[0];

const authorImage = '/patrick-odell-author.jpg';

const news = [
  {
    title: 'New interview released',
    text: 'Patrick discusses worldbuilding and The Godfire Saga.',
    link: '#',
  },
  {
    title: 'Book signing event announced',
    text: 'Upcoming appearance details coming soon.',
    link: '#',
  },
  {
    title: 'Newsletter launched',
    text: 'Monthly updates on books and lore.',
    link: '#',
  },
];
---

<Layout
  metadata={{
    title: 'Patrick O’Dell',
    description: 'Official website of author Patrick O’Dell',
  }}
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-image">
        <img
          src={featured.cover.src}
          width={featured.cover.width}
          height={featured.cover.height}
          alt={featured.title}
        />
      </div>

      <div class="hero-content">
        <p class="eyebrow">THE GODFIRE SAGA</p>

        <h1>{featured.title}</h1>

        {featured.blurb.map((line) => <p>{line}</p>)}

        <div class="hero-actions">
          <a href={`/books/${featured.slug}`} class="primary-btn"> Explore Book </a>

          <a href="/books" class="secondary-btn"> View All Books </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT SECTION ================= -->
  <section class="home-section">
    <div class="section-container split">
      <div class="author-image">
        <a href="/about" aria-label="About the Author">
          <img src={authorImage} alt="Author photo" />
        </a>
      </div>

      <div class="author-text">
        <h2>About the Author</h2>

        <p>Patrick O’Dell is a writer of dark and often comedic fantasy.</p>

        <p>He is the creator of The Godfire Saga and several other interconnected mythic storylines.</p>
      </div>
    </div>
  </section>

  <!-- ================= NEWS SECTION ================= -->
  <section class="home-section alt">
    <div class="section-container">
      <h2 class="center">Latest News</h2>

      <div class="news-box">
        {
          news.map((item) => (
            <a class="news-item" href={item.link}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ================= HERO ================= */

  .hero {
    padding: 90px 24px 120px;
  }

  .hero-container {
    max-width: 1100px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-image img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }

  .hero-content h1 {
    margin: 14px 0 20px;
  }

  .hero-content p {
    font-size: 1.05rem;
  }

  /* ================= GENERAL SECTIONS ================= */

  .home-section {
    padding: 90px 24px;
  }

  .home-section.alt {
    background: rgba(255, 255, 255, 0.02);
  }

  .section-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .center {
    text-align: center;
  }

  /* ================= ABOUT SPLIT ================= */

  .split {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 50px;
    align-items: center;
  }

  .author-image img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }

  .author-image a {
    display: block;
    transition: transform 0.2s ease;
  }

  .author-image a:hover {
    transform: scale(1.02);
  }

  .author-text p {
    font-size: 1.05rem;
  }

  /* ================= NEWS BOX ================= */

  .news-box {
    margin-top: 40px;

    max-height: 260px;
    overflow-y: auto;

    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;

    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .news-item {
    padding: 14px;
    border-radius: 8px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
  }

  .news-item:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .news-item h3 {
    margin: 0 0 6px;
    font-size: 1rem;
  }

  .news-item p {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.8;
  }

  /* ================= BUTTONS ================= */

  .primary-btn,
  .secondary-btn {
    padding: 14px 22px;
    border-radius: 8px;
    text-decoration: none;
    transition: 0.2s ease;
    display: inline-block;
  }

  .primary-btn {
    background: rgba(214, 196, 168, 0.95);
    color: #15130f;
  }

  .secondary-btn {
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .primary-btn:hover,
  .secondary-btn:hover {
    transform: translateY(-2px);
  }

  /* ================= RESPONSIVE ================= */

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .split {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-image img {
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
