---
import Layout from "../layouts/Layout.astro";
import { getFeaturedBook } from "../data/book-utils";

const featured = getFeaturedBook();
---

<Layout
  metadata={{
    title: "Patrick O’Dell | Author",
    description:
      "Official website of Patrick O’Dell, author of The Godfire Series — fantasy and urban fantasy fiction focused on hidden systems, transformation, and the structures beneath reality.",
  }}
>

  <!-- FEATURED BOOK / HERO -->
  <section class="section hero">
    <div class="container center hero-layout">

      <a href={`/books/${featured.slug}`} class="hero-media">
        <img
          src={featured.cover.src}
          width={featured.cover.width}
          height={featured.cover.height}
          alt={featured.title}
          class="hero-image"
        />
      </a>

      <div class="hero-text">

        <span class="kicker">Featured Release</span>

        <h1>{featured.title}</h1>

        <p>
          {featured.blurb?.[0]}
        </p>

        <div class="buttons">
          <a class="btn primary" href={`/books/${featured.slug}`}>
            View Book
          </a>

          <a class="btn secondary" href="/books">
            Explore Series
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- NEWS & UPDATES -->
  <section class="section news-section">
    <div class="container center">

      <div class="section-heading">
        <span class="kicker">News & Updates</span>
        <h2>Latest Updates</h2>
      </div>

      <div class="news-box">

        <article class="news-item">
          <span class="date">May 2026</span>
          <p>The Godfire Series continues development across multiple entries.</p>
        </article>

        <article class="news-item">
          <span class="date">May 2026</span>
          <p>The official website is being rebuilt for an editorial reading experience.</p>
        </article>

        <article class="news-item">
          <span class="date">April 2026</span>
          <p>Elderspeech systems and lore archives are being integrated.</p>
        </article>

        <article class="news-item">
          <span class="date">March 2026</span>
          <p>Worldbuilding documentation continues expanding.</p>
        </article>

      </div>

    </div>
  </section>

  <!-- AUTHOR -->
  <section class="section author-section">
    <div class="container center author-layout">

      <a href="/about" class="author-media">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell Author Portrait"
          class="author-image"
        />
      </a>

      <div class="author-text">

        <span class="kicker">Author</span>

        <h2>Patrick O’Dell</h2>

        <p>
          Patrick O’Dell writes fantasy and urban fantasy fiction centered on
          hidden systems beneath reality, fractured identity, and transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

</Layout>
