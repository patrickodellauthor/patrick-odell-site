---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Patrick O’Dell | Author">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1 class="title">Patrick O’Dell</h1>
      <p class="subtitle">Fantasy & Urban Fantasy Author</p>

      <p class="tagline">
        Stories of broken systems, hidden structures beneath reality, and the cost of power.
      </p>

      <div class="buttons">
        <a class="btn primary" href="/books">Enter The Godfire Series</a>
        <a class="btn secondary" href="/about">About</a>
      </div>
    </div>
  </section>

  <!-- FEATURED BOOK -->
  <section id="books" class="section">
    <div class="container narrow">
      <h2>Featured Book</h2>

      <hr class="section-divider" />

      <div class="book">
        <img src="/gods-and-monsters-cover.jpg" alt="Gods and Monsters Cover" />

        <div class="book-info">
          <h3>Gods and Monsters</h3>

          <span class="series-tag">The Godfire Series</span>

          <p>
            Haunted by the past and hunted by forces beyond understanding, Elias Fetch must decide what he is willing to become to save the people he loves.
          </p>

          <a class="btn primary" href="/books">Explore Books</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="section alt">
    <div class="container narrow">
      <h2>About</h2>

      <hr class="section-divider" />

      <p class="about-text">
        Patrick O’Dell writes fantasy and urban fantasy fiction centered on fractured identities, harsh worlds, and the things people become when certainty begins to fail.
      </p>

      <a class="btn secondary" href="/about">Read More</a>
    </div>
  </section>

  <!-- WORLDS TEASER -->
  <section class="section">
    <div class="container narrow">
      <h2>Worlds & Lore</h2>

      <hr class="section-divider" />

      <p class="lore-text">
        Step behind the stories into the worlds beneath.
      </p>

      <a class="btn secondary" href="/worlds">Explore Lore</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 120px 20px 100px;
    text-align: center;
  }

  .title {
    font-size: 3rem;
    font-weight: 600;
    margin-bottom: 10px;
    letter-spacing: 0.2px;
  }

  .subtitle {
    font-size: 1.05rem;
    opacity: 0.72;
    margin-bottom: 24px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .tagline {
    max-width: 640px;
    margin: 0 auto 32px;
    line-height: 1.7;
    opacity: 0.78;
  }

  .buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section {
    padding: 70px 20px;
  }

  .section.alt {
    background: rgba(0, 0, 0, 0.03);
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
  }

  .container.narrow {
    max-width: 820px;
  }

  h2 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 12px;
    letter-spacing: 0.2px;
  }

  .section-divider {
    border: none;
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
    margin: 0 0 40px 0;
  }

  .book {
    display: flex;
    gap: 36px;
    align-items: center;
    margin-top: 10px;
  }

  .book img {
    width: 190px;
    border-radius: 10px;
  }

  .book-info {
    flex: 1;
  }

  .book-info h3 {
    font-size: 1.7rem;
    margin-bottom: 6px;
  }

  .book-info p {
    line-height: 1.7;
    opacity: 0.8;
    margin-top: 14px;
    max-width: 560px;
  }

  .series-tag {
    font-size: 0.75rem;
    opacity: 0.5;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .about-text,
  .lore-text {
    max-width: 700px;
    line-height: 1.7;
    opacity: 0.8;
  }

  .btn {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 14px;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: black;
    color: white;
  }

  .secondary {
    border: 1px solid black;
    color: black;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 90px 20px 70px;
    }

    .title {
      font-size: 2.4rem;
    }

    .book {
      flex-direction: column;
      align-items: flex-start;
    }

    .book img {
      width: 160px;
    }
  }
</style>
