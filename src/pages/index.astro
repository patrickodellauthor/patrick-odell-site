---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "Patrick O’Dell | Author" }}>

  <!-- HERO / FEATURED BOOK -->
  <section class="section hero-feature">
    <div class="container split">

      <!-- BOOK IMAGE (CLICKABLE) -->
      <a href="/books/gods-and-monsters" class="media">
        <img
          src="/gods-and-monsters-cover.jpg"
          alt="Gods and Monsters Cover"
          class="cover-image"
        />
      </a>

      <!-- BOOK TEXT -->
      <div class="content">

        <span class="section-kicker">Featured Release</span>

        <h1 class="title">Gods and Monsters</h1>

        <p class="text">
          Haunted by the past and hunted by forces beyond understanding,
          Elias Fetch must decide what he is willing to become to save
          the people he loves.
        </p>

        <div class="buttons">
          <a class="btn primary" href="/books/gods-and-monsters">
            View Book
          </a>

          <a class="btn secondary" href="/books">
            Explore Series
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- NEWS / UPDATES (SCROLLABLE BOX) -->
  <section class="section">
    <div class="container split">

      <div class="content">

        <span class="section-kicker">News & Updates</span>
        <h2 class="title-small">Latest Dispatches</h2>

        <div class="news-box">

          <div class="news-item">
            <span class="date">May 2026</span>
            <p>The Godfire Series continues development across multiple entries.</p>
          </div>

          <div class="news-item">
            <span class="date">May 2026</span>
            <p>The official website is being rebuilt for a warmer reading experience.</p>
          </div>

          <div class="news-item">
            <span class="date">April 2026</span>
            <p>New lore systems and Elderspeech archives are in preparation.</p>
          </div>

          <div class="news-item">
            <span class="date">March 2026</span>
            <p>Additional worldbuilding documentation has been added to internal canon.</p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- AUTHOR -->
  <section class="section">
    <div class="container split">

      <!-- AUTHOR IMAGE (CLICKABLE) -->
      <a href="/about" class="media">
        <img
          src="/patrick-odell-author.jpg"
          alt="Patrick O’Dell"
          class="author-image"
        />
      </a>

      <!-- AUTHOR TEXT -->
      <div class="content">

        <span class="section-kicker">Author</span>

        <h2 class="title-small">Patrick O’Dell</h2>

        <p class="text">
          Patrick O’Dell writes fantasy and urban fantasy fiction centered on
          hidden systems beneath reality, fractured identity, and transformation.
        </p>

        <a class="btn secondary" href="/about">
          Read Full Bio
        </a>

      </div>

    </div>
  </section>

</Layout>

<style>

/* LAYOUT CORE */
.split {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 80px;
}

/* IMAGES */
.cover-image,
.author-image {
  width: 100%;
  max-width: 320px;
  border-radius: 8px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.45);
  transition: transform 0.25s ease;
  display: block;
}

.cover-image:hover,
.author-image:hover {
  transform: translateY(-4px);
}

/* TYPOGRAPHY (FIX SIZE ISSUES) */
.title {
  font-size: 2.1rem;
  margin-bottom: 10px;
}

.title-small {
  font-size: 1.6rem;
  margin-bottom: 10px;
}

.text {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(230,220,205,0.8);
}

/* KICKER */
.section-kicker {
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(188,170,146,0.55);
  display: block;
  margin-bottom: 10px;
}

/* BUTTONS */
.buttons {
  display: flex;
  gap: 12px;
  margin-top: 18px;
  flex-wrap: wrap;
}

/* NEWS BOX (SCROLLABLE) */
.news-box {
  max-height: 220px;
  overflow-y: auto;
  padding-right: 10px;

  display: flex;
  flex-direction: column;
  gap: 14px;

  border: 1px solid rgba(214,196,168,0.15);
  padding: 14px;
  border-radius: 6px;
  background: rgba(255,255,255,0.02);
}

.news-item {
  font-size: 0.9rem;
}

.news-item .date {
  font-size: 0.72rem;
  color: rgba(188,170,146,0.6);
  display: block;
  margin-bottom: 4px;
}

/* RESPONSIVE */
@media (max-width: 860px) {
  .split {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .buttons {
    justify-content: center;
  }
}

</style>
