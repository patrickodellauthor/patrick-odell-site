---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  metadata={{
    title: "Watchers in the Dark | Patrick O’Dell",
    description:
      "Watchers in the Dark by Patrick O’Dell — Book Two of The Godfire Series."
  }}
>

  <section class="book-page">
    <div class="book-container">

      <img
        src="/watchers-in-the-dark-cover.jpg"
        alt="Watchers in the Dark Cover"
        width="320"
        height="480"
        loading="eager"
      />

      <div class="book-info">

        <span class="kicker">The Godfire Series — Book Two</span>

        <h1>Watchers in the Dark</h1>

        <p>
          <!-- PLACEHOLDER -->
          (Add your full synopsis here)
        </p>

        <div class="buttons">
          <a class="btn primary" href="/books/watchers-in-the-dark/preview">Preview</a>
          <a class="btn secondary" href="/books">Back to Series</a>
        </div>

      </div>

    </div>
  </section>

</Layout>

<style>
/* same layout as book page */
.book-page { padding: 80px 20px; }

.book-container {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  gap: 48px;
  align-items: flex-start;
}

.book-container img {
  width: 320px;
  height: auto;
  border-radius: 10px;
  box-shadow: 0 25px 70px rgba(0,0,0,0.5);
}

.book-info { max-width: 520px; }

.kicker {
  display: block;
  margin-bottom: 10px;
  opacity: 0.6;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
}

.buttons {
  margin-top: 20px;
  display: flex;
  gap: 12px;
}

@media (max-width: 860px) {
  .book-container {
    flex-direction: column;
    text-align: center;
  }
}
</style>
