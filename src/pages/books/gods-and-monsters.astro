---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  metadata={{
    title: "Gods and Monsters | Patrick O’Dell",
    description:
      "Supernatural fixer Elias Fetch is drawn into a case in Locust Grove, Georgia that unravels memory, identity, and the boundary between reality and something older beneath it.",
    openGraph: {
      images: [
        {
          url: "/gods-and-monsters-cover.jpg",
          width: 600,
          height: 900
        }
      ]
    }
  }}
>

  <!-- BOOK HERO -->
  <section class="book-hero">
    <div class="container">

      <img
        class="cover"
        src="/gods-and-monsters-cover.jpg"
        alt="Gods and Monsters cover"
        width="600"
        height="900"
      />

      <div class="info">

        <h1>Gods and Monsters</h1>

        <p class="series">The Godfire Series</p>

        <p class="blurb">
          Supernatural fixer Elias Fetch returns to Locust Grove, Georgia when a series of unexplained deaths begins to surface.
        </p>

        <p class="blurb">
          When the case turns personal, he is drawn into a spiral of grief, memory, and impossible events that challenge everything he believes about reality.
        </p>

        <p class="blurb">
          Something ancient is moving beneath the surface... and it knows his name.
        </p>

        <div class="actions">
          <a class="btn secondary" href="/books/gods-and-monsters/preview">
            Preview
          </a>

          <a class="btn primary" href="#">
            Pre-order
          </a>
        </div>

        <p class="meta">Coming February 2027</p>

      </div>

    </div>
  </section>

</Layout>

<style>

.book-hero {
  padding: 100px 20px;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  gap: 50px;
  align-items: flex-start;
}

.cover {
  width: 340px;
  border-radius: 8px;
  box-shadow: 0 25px 70px rgba(0,0,0,0.55);
  display: block;
}

.info {
  flex: 1;
  max-width: 620px;
}

.actions {
  display: flex;
  gap: 12px;
  margin-top: 30px;
}

.blurb {
  margin-bottom: 14px;
  line-height: 1.75;
  color: rgba(230,220,205,0.78);
}

.series {
  opacity: 0.7;
  margin-bottom: 14px;
}

.meta {
  margin-top: 18px;
  font-size: 0.85rem;
  opacity: 0.6;
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .container {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .info {
    max-width: 100%;
  }

  .cover {
    width: 260px;
  }
}

</style>
