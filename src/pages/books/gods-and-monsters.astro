---
import Layout from "../../layouts/Layout.astro";
---

<Layout metadata={{ title: "Gods and Monsters | Patrick O’Dell" }}>

  <section class="book-page">

    <div class="book-container">

      <!-- COVER -->
      <a href="/books/gods-and-monsters/preview" class="book-cover-link">
        <img
          class="book-cover"
          src="/gods-and-monsters-cover.jpg"
          alt="Gods and Monsters cover"
        />
      </a>

      <!-- CONTENT -->
      <div class="book-content">

        <span class="kicker">The Godfire Series</span>

        <h1>Gods and Monsters</h1>

        <div class="blurb">
          <p>
            Supernatural fixer Elias Fetch returns to Locust Grove, Georgia when a series of unexplained deaths begins to surface.
          </p>

          <p>
            When the case turns personal, he is drawn into a spiral of grief, memory, and impossible events that challenge everything he believes about reality.
          </p>

          <p>
            Something ancient is moving beneath the surface... and it knows his name.
          </p>
        </div>

        <div class="actions">
          <a class="btn primary" href="PASTE-PURCHASE-LINK">
            Pre-order
          </a>

          <a class="btn secondary" href="/books">
            Back to Books
          </a>
        </div>

        <p class="meta">Coming February 2027</p>

      </div>

    </div>

  </section>

</Layout>

<style>

/* =========================
   BOOK PAGE SYSTEM (UPDATED)
========================= */

.book-page {
  padding: 100px 20px;
}

.book-container {
  max-width: 1000px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 60px;
  align-items: start;
}

/* COVER */
.book-cover {
  width: 100%;
  border-radius: 10px;

  box-shadow:
    0 30px 80px rgba(0,0,0,0.55),
    0 0 1px rgba(255,255,255,0.04);

  transition: transform 0.25s ease;
}

.book-cover:hover {
  transform: translateY(-6px);
}

/* TYPOGRAPHY ALIGNMENT */
.book-content h1 {
  margin-top: 10px;
  margin-bottom: 12px;
  font-size: 2.4rem;
}

.blurb p {
  margin-bottom: 14px;
  line-height: 1.75;
  color: rgba(230, 220, 205, 0.82);
}

/* KICKER */
.kicker {
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(188,170,146,0.55);
}

/* ACTIONS */
.actions {
  display: flex;
  gap: 12px;
  margin-top: 22px;
  flex-wrap: wrap;
}

/* META */
.meta {
  margin-top: 18px;
  font-size: 0.8rem;
  color: rgba(200,190,176,0.55);
}

/* RESPONSIVE */
@media (max-width: 860px) {
  .book-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .actions {
    justify-content: center;
  }
}

</style>
