---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  metadata={{
    title: "Gods and Monsters | Patrick O’Dell",
    description:
      "Gods and Monsters by Patrick O’Dell — Book One of The Godfire Series. A supernatural urban fantasy following Elias Fetch as reality fractures beneath him.",
    openGraph: {
      type: "book",
      images: [
        {
          url: "/gods-and-monsters-cover.jpg"
        }
      ]
    }
  }}
>

  <section class="book-page">
    <div class="book-container">

      <img
        src="/gods-and-monsters-cover.jpg"
        alt="Gods and Monsters Cover"
        width="320"
        height="480"
        loading="eager"
      />

      <div class="book-info">

        <span class="kicker">The Godfire Series — Book One</span>

        <h1>Gods and Monsters</h1>

        <p>
          Supernatural fixer Elias Fetch returns to Locust Grove, Georgia when a series of unexplained deaths begins to surface.
        </p>

        <p>
          When the case turns personal, he is drawn into a spiral of grief, memory, and impossible events that challenge everything he believes about reality.
        </p>

        <p>
          Something ancient is moving beneath the surface—and it knows his name.
        </p>

        <div class="buttons">
          <a class="btn primary" href="/books/gods-and-monsters/preview">Preview</a>
          <a class="btn secondary" href="#">Pre-order</a>
        </div>

        <p class="meta">Coming February 2027</p>

      </div>

    </div>
  </section>

</Layout>

<style>
.book-page {
  padding: 80px 20px;
}

.book-container {
  max-width: 1000px;
  margin: 0 auto;

  display: flex;
  gap: 48px;
  align-items: flex-start;
  justify-content: center;
}

.book-container img {
  border-radius: 10px;
  box-shadow: 0 25px 70px rgba(0,0,0,0.5);
  width: 320px;
  height: auto;
}

.book-info {
  max-width: 520px;
}

.kicker {
  display: block;
  margin-bottom: 10px;
  opacity: 0.6;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 0.75rem;
}

h1 {
  margin-bottom: 14px;
}

p {
  line-height: 1.75;
  opacity: 0.85;
}

.buttons {
  margin-top: 20px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.meta {
  margin-top: 18px;
  font-size: 0.85rem;
  opacity: 0.6;
}

@media (max-width: 860px) {
  .book-container {
    flex-direction: column;
    text-align: center;
  }

  .book-info {
    max-width: 100%;
  }
}
</style>
