---
import Layout from "../../layouts/Layout.astro";
import { books } from "../../data/books";

export function getStaticPaths() {
  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book }
  }));
}

const { book } = Astro.props;
---

<Layout
  metadata={{
    title: `${book.title} | Patrick O’Dell`,
    description: book.seo?.description ?? book.blurb?.[0],

    openGraph: {
      images: [
        {
          url: book.cover.src,
          width: book.cover.width,
          height: book.cover.height
        }
      ]
    }
  }}
>

  <section class="book-hero">
    <div class="container">

      <img
        src={book.cover.src}
        width={book.cover.width}
        height={book.cover.height}
        alt={book.title}
        class="cover"
      />

      <div class="info">

        <h1>{book.title}</h1>

        <p class="series">{book.series}</p>

        {book.blurb.map((line) => (
          <p class="blurb">{line}</p>
        ))}

        <div class="actions">
          {book.status === "published" ? (
            <>
              <a class="btn btn-primary" href="#">Buy / Preorder</a>
              <a class="btn btn-secondary" href={`/books/${book.slug}/preview`}>
                Preview
              </a>
            </>
          ) : (
            <span class="meta">Coming Soon</span>
          )}
        </div>

      </div>

    </div>
  </section>

</Layout>
