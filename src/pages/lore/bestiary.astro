
---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Bestiary | Lore">
  <section class="page">
    <div class="container">

      <h1>Bestiary</h1>

      <p class="intro">
        Entities recorded across multiple incidents. Not all are fully understood.
      </p>

      <div class="list">

        <div class="entry">
          <h3>Unclassified Entities</h3>
          <p>Observed but not fully documented phenomena.</p>
        </div>

        <div class="entry">
          <h3>Dream-born Constructs</h3>
          <p>Beings originating from non-waking cognition zones.</p>
        </div>

        <div class="entry">
          <h3>Fallen Echoes</h3>
          <p>Residual presences tied to catastrophic events.</p>
        </div>

      </div>

    </div>
  </section>
</Layout>

<style>
.page { padding: 80px 20px; }
.container { max-width: 800px; margin: 0 auto; }
h1 { font-size: 2.4rem; }

.entry {
  padding: 16px 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

p { opacity: 0.75; }
</style>
