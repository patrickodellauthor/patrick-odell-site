
---
import Layout from "../../layouts/Layout.astro";
---

<Layout metadata={{ title: "Elderspeech | Lore">
  <section class="page">
    <div class="container">

      <h1>Elderspeech</h1>

      <p class="intro">
        Fragments of an older language. Meaning is unstable and context-dependent.
      </p>

      <div class="block">
        <h3>On Structure</h3>
        <p>
          Elderspeech is not a fixed language. It shifts depending on intent, memory, and speaker perception.
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
.page { padding: 80px 20px; }
.container { max-width: 800px; margin: 0 auto; }

h1 { font-size: 2.4rem; }

.block {
  margin-top: 20px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

.intro { opacity: 0.75; }
p { opacity: 0.8; }
</style>
