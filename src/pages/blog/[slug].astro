---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("post");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Render markdown/MDX content properly
const { Content } = await render(post);
---

<Layout
  metadata={{
    title: `${post.data.title} | Patrick O’Dell`,
    description: post.data.excerpt ?? post.data.title,
    openGraph: {
      images: post.data.image
        ? [
            {
              url: post.data.image
            }
          ]
        : undefined
    }
  }}
>

<article class="post">

  <div class="container">

    <header class="header">
      <h1>{post.data.title}</h1>

      {post.data.publishDate && (
        <div class="meta">
          {new Date(post.data.publishDate).toLocaleDateString()}
        </div>
      )}
    </header>

    <div class="content">
      <Content />
    </div>

  </div>

</article>

</Layout>

<style>
.post {
  padding: 90px 24px;
}

.container {
  max-width: 800px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 40px;
}

.meta {
  opacity: 0.6;
  margin-top: 10px;
}

.content {
  font-size: 1.1rem;
  line-height: 1.8;
}

.content :global(p) {
  margin-bottom: 16px;
}

.content :global(h2),
.content :global(h3) {
  margin-top: 28px;
}
</style>
