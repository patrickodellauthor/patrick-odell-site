---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('post');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, publishDate, excerpt } = post.data;
const { Content } = await render(post);
---

<Layout
  metadata={{
    title: `${title} | Patrick O’Dell`,
    description: excerpt ?? 'Blog post from Patrick O’Dell',
  }}
>
  <article class="post">
    <div class="container">
      <header class="header">
        <h1>{title}</h1>

        {publishDate && <div class="meta">{publishDate.toLocaleDateString()}</div>}
      </header>

      <div class="content">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding: 90px 24px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 40px;
  }

  .meta {
    opacity: 0.6;
    margin-top: 10px;
  }

  .content {
    font-size: 1.1rem;
    line-height: 1.8;
  }
</style>
