
---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/blog";

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
---

<Layout
  metadata={{
    title: `${post.title} | Patrick O’Dell`,
    description: post.description
  }}
>

<article class="post">

  <div class="container">

    <header class="header">
      <h1>{post.title}</h1>
      <div class="meta">{post.date}</div>
    </header>

    <div class="content">
      {post.content.map((p) => (
        <p>{p}</p>
      ))}
    </div>

  </div>

</article>

</Layout>

<style>
.post {
  padding: 90px 24px;
}

.container {
  max-width: 800px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 40px;
}

.meta {
  opacity: 0.6;
  margin-top: 10px;
}

.content p {
  margin-bottom: 16px;
  font-size: 1.1rem;
  line-height: 1.8;
}
</style>
