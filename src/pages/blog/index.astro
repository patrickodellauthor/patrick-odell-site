---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/blog";

const sorted = posts.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Layout
  metadata={{
    title: "Blog | Patrick O’Dell",
    description: "Writing updates, thoughts, and urban fantasy development notes."
  }}
>

<section class="blog">

  <div class="container">

    <header class="header">
      <h1>Blog</h1>
      <p>Writing updates, worldbuilding, and behind-the-scenes notes.</p>
    </header>

    <div class="grid">

      {sorted.map((post) => (
        <a class="card" href={`/blog/${post.slug}`}>
          <div class="meta">{post.date}</div>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
        </a>
      ))}

    </div>

  </div>

</section>

</Layout>

<style>
.blog {
  padding: 90px 24px;
}

.container {
  max-width: 900px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 60px;
}

.header p {
  opacity: 0.8;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.card {
  display: block;
  padding: 18px 20px;
  border-radius: 10px;
  text-decoration: none;

  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);

  transition: 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  background: rgba(255,255,255,0.05);
}

.meta {
  font-size: 0.85rem;
  opacity: 0.6;
  margin-bottom: 6px;
}

.card h2 {
  margin: 0 0 6px;
}

.card p {
  opacity: 0.8;
}
</style>
