---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("post");

function estimateReadingTime(body: string) {
  const wordsPerMinute = 200;
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.round(words / wordsPerMinute));
}
---

<Layout
  metadata={{
    title: "Blog | Patrick O’Dell",
    description:
      "Urban fantasy writing, worldbuilding insights, and updates from Patrick O’Dell."
  }}
>

<section class="blog-page">

  <div class="container">

    <header class="header">
      <h1>Blog</h1>
      <p>
        Stories, worldbuilding notes, and behind-the-scenes writing from my urban fantasy universe.
      </p>
    </header>

    <div class="posts-grid">

      {posts
        .filter((post) => !post.data.draft)
        .sort((a, b) => {
          const aDate = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
          const bDate = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
          return bDate - aDate;
        })
        .map((post) => {

          const readingTime = estimateReadingTime(post.body ?? "");

          return (
            <article class="post-card">

              <a href={`/blog/${post.id}`} class="post-link">

                <header class="post-header">

                  <h2>{post.data.title}</h2>

                  {post.data.excerpt && (
                    <p class="excerpt">{post.data.excerpt}</p>
                  )}

                </header>

                <footer class="post-meta">

                  <div class="meta-row">
                    {post.data.publishDate && (
                      <time datetime={post.data.publishDate.toISOString()}>
                        {new Date(post.data.publishDate).toLocaleDateString()}
                      </time>
                    )}

                    <span class="dot">•</span>

                    <span>{readingTime} min read</span>
                  </div>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="tags">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}

                </footer>

              </a>

            </article>
          );
        })}

    </div>

  </div>

</section>

</Layout>

<style>
.blog-page {
  padding: 90px 24px;
}

.container {
  max-width: 1050px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 60px;
}

.header h1 {
  margin-bottom: 10px;
  font-size: 2.6rem;
}

.header p {
  opacity: 0.75;
  max-width: 650px;
  margin: 0 auto;
  font-size: 1.05rem;
}

/* ================= BLOG GRID ================= */

.posts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 28px;
}

/* ================= CARD ================= */

.post-card {
  border-radius: 14px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  transition: transform 0.2s ease, background 0.2s ease;
  overflow: hidden;
}

.post-card:hover {
  transform: translateY(-4px);
  background: rgba(255,255,255,0.05);
}

.post-link {
  display: flex;
  flex-direction: column;
  padding: 22px;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

/* ================= HEADER ================= */

.post-header h2 {
  font-size: 1.25rem;
  margin-bottom: 10px;
  line-height: 1.3;
}

.excerpt {
  opacity: 0.8;
  font-size: 0.95rem;
  line-height: 1.5;
}

/* ================= META ================= */

.post-meta {
  margin-top: auto;
  padding-top: 16px;
  font-size: 0.85rem;
  opacity: 0.7;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.dot {
  opacity: 0.4;
}

/* ================= TAGS ================= */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tag {
  font-size: 0.75rem;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
}
</style>
