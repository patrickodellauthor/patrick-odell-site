---
import Layout from '~/layouts/Layout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description: 'Contact author Patrick O’Dell',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Say hello"
    subtitle="If you’ve read the books, have a question about the worlds, or just want to reach out, I’m always glad to hear from readers."
  />

  <ContactUs
    id="form"
    title="Send a note"
    subtitle="I read every message and usually reply within a few days."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Your Email',
      },
    ]}
    textarea={{
      label: 'Your Message',
    }}
    disclaimer={{
      label: 'By sending this note, you agree that it will be delivered directly to me.',
    }}
    description="Messages go to: patrickodellauthor@gmail.com"
    button="Send message"
  />

  <Features2
    title="What I’m happy to hear about"
    items={[
      {
        title: 'The Godfire Saga',
        description: 'Questions, theories, favorite scenes, or lingering mysteries.',
      },
      {
        title: 'Reader reactions',
        description: 'I love hearing what landed with you and what surprised you.',
      },
      {
        title: 'Events & interviews',
        description: 'Podcasts, events, guest posts, and press inquiries.',
      },
      {
        title: 'Collaborations',
        description: 'Writing projects, creative partnerships, and shared ideas.',
      },
      {
        title: 'Email',
        description: 'patrickodellauthor@gmail.com',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
