---
import Layout from '~/layouts/Layout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description: 'Contact author Patrick O’Dell',
};
---

<Layout metadata={metadata} footer={false}>

  <HeroText
    tagline="Contact"
    title="Let’s Talk"
    subtitle="If you’ve read my books, have questions, theories, or just want to say hello — I’m always happy to hear from readers."
  />

  <ContactUs
    id="form"
    title="Send a message"
    subtitle="Drop a note below. I read everything, and I usually respond within a few days."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Your Email',
      },
    ]}
    textarea={{
      label: 'Your Message',
    }}
    disclaimer={{
      label:
        'By sending this message, you agree that your message will be delivered directly to the author.',
    }}
    description="Messages go to: patrickodellauthor@gmail.com"
  />

  <Features2
    title="What you can reach out about"
    items={[
      {
        title: 'Books & Stories',
        description: 'Questions, theories, reactions, or favorite moments.',
      },
      {
        title: 'Reader Messages',
        description: 'I genuinely enjoy hearing from readers.',
      },
      {
        title: 'Media & Interviews',
        description: 'Podcasts, interviews, guest posts, and press.',
      },
      {
        title: 'Collaborations',
        description: 'Creative or writing-related projects.',
      },
      {
        title: 'Email',
        description: 'patrickodellauthor@gmail.com',
        icon: 'tabler:mail',
      },
    ]}
  />

</Layout>
