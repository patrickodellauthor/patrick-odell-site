---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
  description: 'Contact author Patrick O’Dell',
};
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <HeroText
    tagline="Contact"
    title="Let’s Talk"
    subtitle="If you’ve read my work, spotted a typo, have theories, questions, or just want to say hello — I’m always happy to hear from readers."
  />

  <!-- CONTACT FORM -->
  <ContactUs
    id="form"
    title="Send a message"
    subtitle="Drop a note below. I read everything that comes in (yes, even the long ones). I’ll usually respond within a few days."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Your Email',
      },
    ]}
    textarea={{
      label: 'Your Message',
    }}
    disclaimer={{
      label:
        'By sending this message, you understand it will go directly to the author’s inbox.',
    }}
    description="Messages go to: patrickodellauthor@gmail.com"
  />

  <!-- CONTACT INFO -->
  <Features2
    title="What you can contact me about"
    items={[
      {
        title: 'Books & Stories',
        description:
          'Thoughts, questions, theories, or “I can’t believe that happened” reactions.',
      },
      {
        title: 'Reader Messages',
        description:
          'I genuinely enjoy hearing how the stories land — confusion, excitement, and everything in between.',
      },
      {
        title: 'Media & Interviews',
        description:
          'Podcasts, interviews, guest features, or anything press-related.',
      },
      {
        title: 'Collaborations',
        description:
          'Creative projects, crossovers, or other writing-related work.',
      },
      {
        title: 'Email',
        description: 'patrickodellauthor@gmail.com',
        icon: 'tabler:mail',
      },
    ]}
  />

</Layout>
