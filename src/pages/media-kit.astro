
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Media Kit | Patrick O’Dell">
  <section class="page">
    <div class="container">

      <h1>Media Kit</h1>

      <p class="intro">
        Author information, book details, and press materials.
      </p>

      <div class="block">
        <h3>Author Bio</h3>
        <p>Patrick O’Dell writes dark fantasy and urban fantasy rooted in character-driven transformation and consequence.</p>
      </div>

      <div class="block">
        <h3>Books</h3>
        <p>Includes The Godfire Series: Gods and Monsters, Watchers in the Dark, and The Dream Eater’s Bargain.</p>
      </div>

    </div>
  </section>
</Layout>

<style>
.page { padding: 80px 20px; }
.container { max-width: 800px; margin: 0 auto; }
h1 { font-size: 2.4rem; }
.block {
  margin-top: 20px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  padding-bottom: 16px;
}
.intro { opacity: 0.75; }
p { opacity: 0.8; }
</style>
