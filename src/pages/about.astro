---
import Layout from "../layouts/Layout.astro";
---

<Layout metadata={{ title: "About | Patrick O’Dell" }}>

<section class="section">
  <div class="container narrow">

    <h1>Patrick O’Dell</h1>

    <p class="about-lead">
      I write fantasy and urban fantasy fiction about systems beneath reality,
      fractured identity, and the cost of becoming something you cannot undo.
    </p>

    <p>
      My work focuses on the idea that reality is structured—quietly, invisibly—
      and that people only notice those structures when they begin to break.
    </p>

  </div>
</section>

<section class="section alt">
  <div class="container narrow">

    <h2>What I Write</h2>

    <p>
      The Godfire Series explores hidden frameworks of existence,
      power that reshapes perception, and the consequences of understanding too much.
    </p>

  </div>
</section>

<section class="section">
  <div class="container narrow">

    <h2>Start Here</h2>

    <a class="btn primary" href="/books/gods-and-monsters">
      Read Gods and Monsters
    </a>

  </div>
</section>

<section class="section alt">
  <div class="container narrow">

    <h2>Stay Connected</h2>

    <p>
      Get updates on new releases and worldbuilding expansions.
    </p>

    <form>
      <input type="email" placeholder="Email address" />
      <button class="btn primary">Subscribe</button>
    </form>

  </div>
</section>

</Layout>
