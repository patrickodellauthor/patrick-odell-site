---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

import Footer from '~/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props as Props;

const { language, textDirection } = I18N;

const pageMetadata = {
  title: metadata.title ?? 'Patrick O’Dell | Author',
  description: metadata.description ?? 'Official website of author Patrick O’Dell.',
  ...metadata,
};
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />

    <Metadata {...pageMetadata} />

    <SiteVerification />
    <Analytics />

    <ClientRouter fallback="swap" />
  </head>

  <body class="site-body">

    <!-- ================= HEADER ================= -->

    <header class="site-header">

      <div class="header-inner">

        <a class="logo-link" href="/" aria-label="Patrick O’Dell Home">
          <img
            src="/patrick-odell-logo.png"
            alt="Patrick O’Dell"
            class="site-logo"
          />
        </a>

        <nav class="main-nav">

          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/books">Books</a>
          <a href="/blog">Blog</a>
          <a href="/faq">FAQ</a>
          <a href="/media-kit">Media Kit</a>
          <a href="/contact">Contact</a>

        </nav>

      </div>

    </header>

    <!-- ================= MAIN CONTENT ================= -->

    <main class="site-main">
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->

    <Footer />
    <BasicScripts />

  </body>
</html>

<style>
.site-body {
  margin: 0;
  background: #15130f;
  color: rgba(240, 232, 220, 0.88);
  font-family: ui-serif, Georgia, "Times New Roman", serif;
}

/* ================= HEADER ================= */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;

  background: rgba(15, 14, 12, 0.82);
  backdrop-filter: blur(14px);

  border-bottom: 1px solid rgba(210,198,178,0.08);
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;

  padding: 18px 24px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ================= LOGO ================= */

.site-logo {
  height: 200px;
  width: auto;
  display: block;
  object-fit: contain;
}

/* ================= NAV ================= */

.main-nav {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;

  margin-top: 10px;
}

.main-nav a {
  color: rgba(230,220,205,0.82);
  text-decoration: none;
  font-size: 0.95rem;
  transition: 0.2s ease;
}

.main-nav a:hover {
  color: rgba(255,255,255,0.96);
}

/* ================= MAIN CONTENT ================= */

.site-main {
  width: 100%;
}

/* ================= GLOBAL SECTION CONTROL ================= */

section {
  width: 100%;
}

.container,
.content-section,
.hero-section {
  max-width: 1200px;
  margin: 0 auto;
  padding-left: 24px;
  padding-right: 24px;
}

/* ================= TYPOGRAPHY ================= */

h1 {
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  line-height: 1.1;
}

h2 {
  font-size: clamp(2rem, 4vw, 3rem);
}

h3 {
  font-size: 1.4rem;
}

p {
  font-size: 1.08rem;
  line-height: 1.8;
}

/* ================= MOBILE ================= */

@media (max-width: 900px) {

  .site-logo {
    height: 140px;
  }

  .main-nav {
    gap: 16px;
  }

  p {
    font-size: 1rem;
  }
}
</style>
