---
import Layout from "./Layout.astro";
import { I18N } from "astrowind:config";

const { language, textDirection } = I18N;

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout
  metadata={{
    title,
    description,
  }}
>
  <slot />
</Layout>
