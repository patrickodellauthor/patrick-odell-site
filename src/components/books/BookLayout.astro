---
interface Props {
  title: string;
  series?: string;
  cover: string;
  blurb: string;
  extraBlurb?: string;
  finalBlurb?: string;
  buyLink?: string;
  previewLink?: string;
  meta?: string;
}

const { title, series, cover, blurb, extraBlurb, finalBlurb, buyLink, previewLink, meta } = Astro.props;
---

<section class="book-page">
  <div class="book-container">
    <!-- COVER -->
    <div class="book-media">
      <img class="book-cover" src={cover} alt={`${title} cover`} />
    </div>

    <!-- CONTENT -->
    <div class="book-content">
      {series && <span class="kicker">{series}</span>}

      <h1>{title}</h1>

      <div class="blurb">
        <p>{blurb}</p>

        {extraBlurb && <p>{extraBlurb}</p>}
        {finalBlurb && <p>{finalBlurb}</p>}
      </div>

      <div class="actions">
        {
          previewLink && (
            <a class="btn secondary" href={previewLink}>
              Preview
            </a>
          )
        }

        {
          buyLink && (
            <a class="btn primary" href={buyLink}>
              Pre-order
            </a>
          )
        }

        <a class="btn secondary" href="/books"> Back to Books </a>
      </div>

      {meta && <p class="meta">{meta}</p>}
    </div>
  </div>
</section>

<style>
  .book-page {
    padding: 100px 20px;
  }

  .book-container {
    max-width: 1000px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 60px;
    align-items: start;
  }

  .book-cover {
    width: 100%;
    border-radius: 10px;

    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    transition: transform 0.25s ease;
  }

  .book-cover:hover {
    transform: translateY(-6px);
  }

  .book-content h1 {
    margin-top: 10px;
    margin-bottom: 12px;
    font-size: 2.4rem;
  }

  .blurb p {
    margin-bottom: 14px;
    line-height: 1.75;
    color: rgba(230, 220, 205, 0.82);
  }

  .kicker {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(188, 170, 146, 0.55);
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 22px;
    flex-wrap: wrap;
  }

  .meta {
    margin-top: 18px;
    font-size: 0.8rem;
    color: rgba(200, 190, 176, 0.55);
  }

  @media (max-width: 860px) {
    .book-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .actions {
      justify-content: center;
    }
  }
</style>
